# Ignore the output video from Git but not videos you import into src/.
out

# 생성된 출력 파일
output/
output_narration.wav
output_with_bgm.mp4
output.wav
output_bgm.tmp
input/

# Python 캐시
__pycache__/
*.pyc

# BGM 음원 (개인 파일 — 폴더 구조만 추적)
bgm/**/*.mp3
bgm/**/*.wav
